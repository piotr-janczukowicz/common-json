<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.piotr-janczukowicz</groupId>
    <artifactId>common-parent</artifactId>
    <version>7</version>
    <relativePath/>
  </parent>

  <artifactId>common-json</artifactId>
  <version>5-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>common-json</name>
  <description>A Jackson-free JsonCodec contract, an OptionalNull wrapper for PATCH-style payloads, and Jackson 3 adapters for union-shaped JSON</description>
  <url>https://github.com/piotr-janczukowicz/common-json</url>

  <properties>
    <common-util.version>7</common-util.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.github.piotr-janczukowicz</groupId>
      <artifactId>common-util</artifactId>
      <version>${common-util.version}</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-nop</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <profiles>
    <profile>
      <!-- Opt-in: runs PMD with every rule enabled on test sources. Activate with -Ppmd-test. -->
      <id>pmd-test</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-pmd-plugin</artifactId>
            <executions>
              <execution>
                <id>pmd-test</id>
                <phase>process-test-classes</phase>
                <goals>
                  <goal>pmd</goal>
                </goals>
                <configuration>
                  <includeTests>true</includeTests>
                  <rulesets combine.self="override">
                    <ruleset>${project.basedir}/pmd/pmd-test-ruleset.xml</ruleset>
                  </rulesets>
                  <compileSourceRoots combine.self="override">
                    <compileSourceRoot>${project.basedir}/src/test/java</compileSourceRoot>
                  </compileSourceRoots>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
