  <version>3-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>common-json</name>
  <description>Shared JSON utilities</description>
  <url>https://github.com/piotr-janczukowicz/common-json</url>
  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
    </license>
  </licenses>

  <scm>
    <connection>scm:git:https://github.com/piotr-janczukowicz/common-json.git</connection>
    <developerConnection>scm:git:https://github.com/piotr-janczukowicz/common-json.git</developerConnection>
    <url>https://github.com/piotr-janczukowicz/common-json</url>
  </scm>
  <distributionManagement>
    <repository>
      <id>github</id>
      <name>GitHub Packages</name>
      <url>https://maven.pkg.github.com/piotr-janczukowicz/common-json</url>
